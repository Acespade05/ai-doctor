PATIENTS=[{"name":"shopsmart-prod","url":"http://shopsmart-aisre.duckdns.org:8080"}]
PUBLIC_PROBE_URL=https://shopsmart-aisre.duckdns.org/health
POLL_INTERVAL=10
HTTP_TIMEOUT=5
DB_PATH=./data/doctor.db

# rules-first thresholds (interim; Isolation Forest replaces CPU/mem later)
CPU_HIGH=90
MEM_HIGH=90
DISK_HIGH=90
PROBE_LATENCY_HIGH_MS=3000
AGENT_STALE_SECONDS=60

# --- remediation ---
# Same secret must be set in the ShopSmart agent's AGENT_TOKEN.
AGENT_TOKEN=PASTE-SAME-LONG-RANDOM-SECRET-IN-BOTH-ENVS
AUTO_REMEDIATE=true           # false = Doctor only recommends; you approve each fix
REMEDIATION_MAX_ATTEMPTS=2
REMEDIATION_COOLDOWN=30
REMEDIATION_TARGET=shopsmart_app

# --- LLM / RAG diagnosis (Tier 2/3) ---
# Free key at console.groq.com. Leave empty to run rules-only (Tier 1).
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
RAG_ENABLED=true
